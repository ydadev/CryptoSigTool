<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CryptoSigTool-Setup</AssemblyName>
    <RootNamespace>CryptoSigTool.Installer</RootNamespace>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>CryptoSigTool Installer</Product>
    <Company>ydadev</Company>
    <ApplicationIcon>..\CryptoSigTool\Assets\CryptoSigTool.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Bundle\*" Exclude="Bundle\.gitkeep" />
  </ItemGroup>
</Project>
